#!/usr/bin/env bash
# Builds and runs every test, including the Testcontainers ones, so Docker must
# be running. CI runs this same script. Gradle args pass through, e.g.
# `./auto/test --rerun-tasks` or `./auto/test :event-validator:test`.
set -euo pipefail
cd "$(dirname "$0")/.."
./gradlew build "$@"
