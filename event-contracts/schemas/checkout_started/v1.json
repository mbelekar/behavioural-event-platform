{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "checkout_started",
  "allOf": [
    { "$ref": "behavioural_envelope/v1.json" },
    {
      "properties": {
        "eventType": { "const": "checkout_started" },
        "payload": {
          "type": "object",
          "required": ["cartId"],
          "properties": {
            "cartId": { "type": "string", "minLength": 1 },
            "itemCount": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
